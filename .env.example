# =============================================================================
#  Conveyor AI Ops — variables d'environnement (copier en `.env` à la racine)
#
#  Aucune valeur n'est obligatoire : `docker compose up` fonctionne tel quel en
#  mode SIMULATION. Ce fichier sert à personnaliser le déploiement.
# =============================================================================

# --- Mode de fonctionnement --------------------------------------------------
# SIMULATION : le banc est simulé physiquement (démo sans matériel)
# HARDWARE   : seules les trames MQTT de l'ESP32 sont utilisées
# HYBRID     : M1 réel + M2 simulé (mise au point progressive du banc)
MODE=SIMULATION
SIM_HZ=8

# --- Broker MQTT -------------------------------------------------------------
MQTT_ENABLED=true
MQTT_USERNAME=conveyor
MQTT_PASSWORD=conveyor
MQTT_BACKEND_USERNAME=conveyor-backend
MQTT_BACKEND_PASSWORD=conveyor
MQTT_MONITOR_USERNAME=conveyor-monitor
MQTT_MONITOR_PASSWORD=monitor
MQTT_TLS=false
# MQTT_CA_CERT=/mosquitto/certs/ca.crt

# --- Frontend ---------------------------------------------------------------
# Le backend est joint par le serveur Next (proxy /api et /ws) : ne pas exposer
# directement l'IP du backend au navigateur.
BACKEND_URL=http://backend:8000
# Décommenter si votre reverse-proxy ne relaie pas les WebSocket :
# NEXT_PUBLIC_BACKEND_WS=ws://localhost:8000

# --- Sécurité ----------------------------------------------------------------
SECRET_KEY=changez-cette-cle-en-production-64-caracteres-aleatoires
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Base de données ---------------------------------------------------------
# SQLite (par défaut, zéro configuration) ou PostgreSQL/TimescaleDB :
# DATABASE_URL=postgresql+psycopg://conveyor:conveyor@timescaledb:5432/conveyor
DATABASE_URL=sqlite:////app/data/conveyor.db

# --- Cache / pub-sub (optionnel : docker compose --profile cache up) ----------
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0

# --- IA ---------------------------------------------------------------------
ML_ACTIVE_BUNDLE=conveyor-synth
ML_MODEL_VERSION=v1.4.0
ML_RUN_INFERENCE_HZ=1
RUL_CRITICAL_HEALTH=40
# Anti-flapping des alertes IA (N inférences concordantes + temporisation)
AI_CONFIRMATIONS=3
AI_DEBOUNCE_S=90
ANOMALY_CONFIRMATIONS=3
ANOMALY_DEBOUNCE_S=120

# --- Notifications (facultatif) ---------------------------------------------
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@conveyor.local
ALERT_WEBHOOK_ENABLED=false
WEBHOOK_URL=

# --- Rétention et rapports ---------------------------------------------------
RAW_RETENTION_DAYS=7
FEATURE_RETENTION_DAYS=90
REPORT_COMPANY=Projet IoT & Edge AI
REPORT_AUTHOR=Cellule Maintenance Prédictive
