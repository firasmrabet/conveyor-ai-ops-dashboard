# =====================================================================
#  Conveyor AI Ops — variables d'environnement backend
#  Copier en `.env` puis ajuster.
# =====================================================================

# --- Mode de fonctionnement ---
# HARDWARE   : écoute le vrai broker MQTT alimenté par l'ESP32
# SIMULATION : générateur de signaux physiquement réalistes (soutenance sans matériel)
MODE=SIMULATION
# HYBRID : simulation locale + MQTT réel en parallèle (tests mixtes)
SIMULATE_ON_M1=true
SIMULATE_ON_M2=true
# Fréquence de publication du simulateur (Hz)
SIM_HZ=8
# Publie aussi sur MQTT en mode simulation (utile pour tester scripts/esp32_simulator.py)
SIM_PUBLISH_MQTT=false

# --- API ---
APP_NAME=Conveyor AI Ops
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
RATE_LIMIT_PER_MINUTE=600

# --- Base de données ---
# SQLite (POC) ou PostgreSQL/TimescaleDB :
# postgresql+psycopg://conveyor:conveyor@db:5432/conveyor
DATABASE_URL=sqlite:///./data/conveyor.db
DB_ECHO=false

# --- MQTT ---
MQTT_ENABLED=false
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_ID=conveyor-backend
MQTT_TOPIC_PREFIX=conveyor
MQTT_QOS=1

# --- Redis (optionnel : ring buffer + pub/sub + cache) ---
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0

# --- ML ---
ML_ARTIFACTS_DIR=./artifacts
ML_ACTIVE_BUNDLE=conveyor-synth
ML_MODEL_VERSION=v1.4.0
ML_RUN_INFERENCE_HZ=1
RUL_CRITICAL_HEALTH=40
# Anti-flapping des alertes IA (confirmations consécutives + temporisation en secondes)
AI_CONFIRMATIONS=3
AI_DEBOUNCE_S=90
ANOMALY_CONFIRMATIONS=3
ANOMALY_DEBOUNCE_S=120

# --- Alerting ---
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@conveyor.local
ALERT_WEBHOOK_ENABLED=false
WEBHOOK_URL=
ALERT_SOUND_ENABLED=true

# --- Rétention ---
RAW_RETENTION_DAYS=7
FEATURE_RETENTION_DAYS=90

# --- Rapport PDF ---
REPORT_COMPANY=ENISo / Projet IoT & Edge AI
REPORT_AUTHOR=Cellule Maintenance Prédictive
